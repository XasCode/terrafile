set -eu

if ! command -v detect-secrets >/dev/null 2>&1; then
    echo "Error: required system command 'detect-secrets' is not installed." >&2
    exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    echo "Error: required system command 'jq' is not installed." >&2
    exit 1
fi

WORDLIST_ARG=""
if [ -f wordlist.txt ] && [ -s wordlist.txt ]; then
    if ! command -v python >/dev/null 2>&1 || ! python -c "import ahocorasick" >/dev/null 2>&1; then
        echo "Error: wordlist.txt requires Python and pyahocorasick." >&2
        echo "Install it with: python -m pip install pyahocorasick" >&2
        exit 1
    fi
    WORDLIST_ARG="--word-list wordlist.txt"
fi

cleanup() {
    rm -f base.fifo new.fifo .secrets.new
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
rm -f base.fifo new.fifo .secrets.new

# Create a baseline when one is missing or empty.
if [ ! -s .secrets.baseline ]; then
    echo "Creating baseline..."
    detect-secrets scan --no-verify $WORDLIST_ARG --exclude-files 'node_modules|coverage|\.secrets\.' --all-files . > .secrets.baseline
fi

# backup the list of known secrets
cp .secrets.baseline .secrets.new

# find all the secrets in the repository
echo "Running detect-secrets on repo..."
detect-secrets scan --no-verify $WORDLIST_ARG --exclude-files 'node_modules|coverage|\.secrets\.' --baseline .secrets.new $(find . -type f ! -name '.secrets.*' ! -path '*/.git*' ! -path '*/node_modules/*') > /dev/null

# if there is any difference between the known and newly detected secrets, break the build
list_secrets() { jq -r '.results | keys[] as $key | "\($key | gsub("\\\\"; "/")),\(.[$key] | .[] | .hashed_secret)"' "$1" | sort; }

# create named pipes
mkfifo base.fifo
mkfifo new.fifo

# run the list_secrets command
list_secrets .secrets.baseline >base.fifo &
list_secrets .secrets.new >new.fifo &

# compare the two lists
if ! diff new.fifo base.fifo >&2 ; then
  echo "Detected new secrets in the repo" >&2
  exit 1
fi
