# Check if detect-secrets is installed
if ! command -v detect-secrets >/dev/null 2>&1
then
    echo "Warning: detect-secrets is not installed."
    echo "!!! detect-secrets will not be run."
    exit 0
fi
# Check if jq is installed
if ! command -v jq >/dev/null 2>&1
then
    echo "Warning: jq is not installed."
    echo "!!! detect-secrets will not be run."
    exit 0
fi

# This wrapper does not support --word-list; discard baselines made with it.
if grep -Eq '"file_name": "wordlist\.txt"|"filename": "\.secrets\.new"' .secrets.baseline 2>/dev/null; then
    echo "Rebuilding stale secret baseline..."
    rm -f .secrets.baseline
fi

cleanup() {
    rm -f base.fifo new.fifo .secrets.new
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
rm -f base.fifo new.fifo .secrets.new

# Create a baseline when one is missing or empty.
if [ ! -s .secrets.baseline ]; then
    echo "Creating baseline..."
    detect-secrets scan --no-verify --exclude-files 'node_modules|\.secrets\.' --all-files . > .secrets.baseline
fi

# backup the list of known secrets
cp .secrets.baseline .secrets.new

# find all the secrets in the repository
echo "Running detect-secrets on repo..."
detect-secrets scan --no-verify --exclude-files 'node_modules|\.secrets\.' --baseline .secrets.new $(find . -type f ! -name '.secrets.*' ! -path '*/.git*' ! -path '*/node_modules/*') > /dev/null

# if there is any difference between the known and newly detected secrets, break the build
list_secrets() { jq -r '.results | keys[] as $key | "\($key | gsub("\\\\"; "/")),\(.[$key] | .[] | .hashed_secret)"' "$1" | sort; }

# create named pipes
mkfifo base.fifo
mkfifo new.fifo

# run the list_secrets command
list_secrets .secrets.baseline >base.fifo &
list_secrets .secrets.new >new.fifo &

# compare the two lists
if ! diff new.fifo base.fifo >&2 ; then
  echo "Detected new secrets in the repo" >&2
  exit 1
fi
