# Check if detect-secrets is installed
if ! command -v detect-secrets >/dev/null 2>&1
then
    echo "Warning: detect-secrets is not installed."
    echo "!!! detect-secrets will not be run."
    exit 0
fi
# if there is no baseline, create one
if [ ! -s .secrets.baseline ]; then
    echo "Creating baseline..."
    detect-secrets scan --no-verify --exclude-files 'node_modules' --all-files . > .secrets.baseline
fi

echo "Running detect-secrets on prepare-commit-msg..."
# Scans the commit message.
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
if detect-secrets scan --no-verify --string "$COMMIT_MSG" | grep -q "True"; then
    echo "Detected potential secrets in commit message"
    exit 1
fi
